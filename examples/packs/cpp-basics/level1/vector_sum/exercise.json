{
  "schema_version": 3,
  "id": "vector_sum",
  "type": "exercise",
  "name": "Vector Sum",
  "subject": "subject.md",
  "programming_language": "cpp",
  "content_language": "pt-BR",
  "topics": [
    "cpp",
    "basics"
  ],
  "submission": {
    "filename": "vector_sum.cpp"
  },
  "usage": {
    "allowed": {
      "libraries": [
        "vector"
      ]
    },
    "constraints": [
      "Passe o vetor por referência constante."
    ]
  },
  "validation": {
    "strategy": "function_call",
    "tests": {
      "generator": "fixed_cases",
      "expectation": "literal",
      "cases": [
        {
          "args": [
            "1",
            "2",
            "3"
          ],
          "expected": "6\n"
        },
        {
          "args": [
            "-5",
            "7"
          ],
          "expected": "2\n"
        }
      ]
    },
    "limits": {
      "timeout_seconds": 3
    },
    "harness": "harness/main.cpp",
    "support_files": [
      "include/vector_sum.hpp"
    ]
  }
}
