{
  "schema_version": 3,
  "id": "line_join",
  "type": "exercise",
  "name": "Line Join",
  "subject": "subject.md",
  "programming_language": "cpp",
  "content_language": "pt-BR",
  "topics": [
    "cpp",
    "basics"
  ],
  "submission": {
    "filename": "line_join.cpp"
  },
  "usage": {
    "allowed": {
      "libraries": [
        "iostream",
        "string"
      ]
    },
    "forbidden": {
      "functions": [
        "printf"
      ]
    }
  },
  "validation": {
    "strategy": "program_output",
    "tests": {
      "generator": "fixed_cases",
      "expectation": "literal",
      "cases": [
        {
          "args": [
            "a",
            "b",
            "c"
          ],
          "expected": "a-b-c\n"
        },
        {
          "args": [
            "solo"
          ],
          "expected": "solo\n"
        },
        {
          "args": [],
          "expected": "\n"
        }
      ]
    },
    "limits": {
      "timeout_seconds": 3
    }
  }
}
