{
  "schema_version": 3,
  "id": "max_value",
  "type": "exercise",
  "name": "Max Value",
  "subject": "subject.md",
  "programming_language": "python",
  "content_language": "pt-BR",
  "topics": [
    "python",
    "basics"
  ],
  "submission": {
    "filename": "max_value.py"
  },
  "usage": {
    "allowed": {
      "imports": []
    },
    "forbidden": {
      "functions": [
        "print"
      ]
    },
    "constraints": [
      "Percorra a lista manualmente."
    ]
  },
  "validation": {
    "strategy": "function_call",
    "tests": {
      "generator": "fixed_cases",
      "expectation": "literal",
      "cases": [
        {
          "args": [
            "[1, 4, 2]"
          ],
          "expected": "4\n"
        },
        {
          "args": [
            "[-5, -2, -9]"
          ],
          "expected": "-2\n"
        }
      ]
    },
    "limits": {
      "timeout_seconds": 3
    },
    "entry": "max_value",
    "args_format": "json"
  }
}
